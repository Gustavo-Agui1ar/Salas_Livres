<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MelhoresFragment">

    <Button
        android:id="@+id/confirmarM"
        style="@style/ConfirmButtonStyle"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/campoTurnoM" />

    <EditText
        android:id="@+id/campoBlocoM"
        style="@style/InputText"
        android:layout_marginHorizontal="35dp"
        android:autofillHints="sala"
        android:hint="@string/hint_numero_sala"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.475"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="152dp" />

    <EditText
        android:id="@+id/campoTurnoM"
        style="@style/InputText"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="20dp"
        android:hint="@string/hint_dia_turno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/campoBlocoM" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewM"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="45dp"
        android:layout_marginVertical="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmarM" />

</androidx.constraintlayout.widget.ConstraintLayout>